# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_…) or legacy anon key — safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_…) or legacy service_role key — SERVER ONLY, used by /api/cron
SUPABASE_SECRET_KEY=

# --- App ---
# Public URL, used in auth email links (e.g. https://wasalni.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Home city slug (default: el-fahs)
NEXT_PUBLIC_HOME_CITY_SLUG=el-fahs
# Optional: shown on the Help page
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Scheduled jobs fallback (only needed if pg_cron is not enabled) ---
CRON_SECRET=
